# .gitattributes — 强制 Git 按 UTF-8 与 LF 处理文件
# 作用：
#   1. 防止 Git 自动转换换行符导致"整个文件都是改动"
#   2. 让 AI 的改动 diff 清晰可读
# ⚠️ 必须在第一次提交前放好，否则要执行：git add --renormalize .

* text=auto eol=lf

# 源码与文本 —— 强制 LF
*.py    text eol=lf
*.pyi   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.sql   text eol=lf
*.sh    text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.editorconfig   text eol=lf
Dockerfile      text eol=lf

# Windows 脚本保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制 —— 禁止任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bmp   binary
*.ico   binary
*.webp  binary
*.svg   text eol=lf
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.7z    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.mp3   binary
*.mp4   binary
*.xlsx  binary
*.docx  binary

# Git 语言统计（避免把生成文件算进语言占比）
*.lock          linguist-generated=true
uv.lock         linguist-generated=true
package-lock.json linguist-generated=true
pnpm-lock.yaml  linguist-generated=true
*.min.js        linguist-generated=true
*.min.css       linguist-generated=true

# 生产环境变量模板
#
# 用法：
#   cp env.prod.example /etc/rag-qa/env
#   chmod 600 /etc/rag-qa/env && chown root:ragqa /etc/rag-qa/env
#   编辑后由 /etc/systemd/system/rag-qa.service 的 EnvironmentFile 读取
#
# 严禁把填写后的文件提交到 Git，也不要把密码写进命令行参数（会进 shell history）。

# ---------- 必填：任一项缺失，应用启动即失败（这是有意设计）----------
SPRING_PROFILES_ACTIVE=prod
DB_URL="jdbc:mysql://127.0.0.1:3306/rag_qa?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false"
DB_USERNAME=rag_qa_app
DB_PASSWORD=

# ---------- 路径：Linux 上必须显式指定 ----------
# 不设会退回到 application.yml 里的 E:/Codex/... 默认值，Linux 上会凭空建目录。
# 这两个目录需 chown 给运行账号，且不得被 Nginx 静态映射。
KNOWLEDGE_STORAGE_ROOT=/data/knowingorder/knowledge
KNOWLEDGE_UPLOAD_TEMP=/data/knowingorder/tmp

# ---------- 访问方式 ----------
# 无域名、以 http://IP:8090 访问时必须设 false，否则浏览器不回传会话 Cookie，
# 表现为「登录成功但立刻变回未登录」。
# 一旦接入 HTTPS，删除本行即可回到默认的 true。
SESSION_COOKIE_SECURE=false

# 前后端同域（Nginx 反代），无需跨域，留空 = 不开放任何跨域来源
CORS_ALLOWED_ORIGINS=

# ---------- 外部能力：不填则对应功能不可用 ----------
TAVILY_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=
LLM_MODEL=

# ---------- 登录限流 ----------
# 经 Nginx 反代后，所有请求的来源地址都是 127.0.0.1，「每地址」阈值实际变成全站共享。
# 演示期调到 30 以免反复切账号时被自己限流。
LOGIN_PER_ADDRESS_PER_MINUTE=30
LOGIN_GLOBAL_PER_MINUTE=120

# ---------- 范围识别（校内 / 校外判断）----------
# 格式：企业编号:空间编号，多个用逗号分隔。留空 = 不对任何空间启用范围识别。
# 启用还要求该空间为 SYNTHETIC_MODEL 模式，即会把问题发给外部模型，
# 因此只允许配合虚构测试资料使用。
# KNOWLEDGE_SYNTHETIC_MODEL_SPACES=
